{
  "name": "pi-x-ide",
  "version": "0.1.0",
  "description": "Pi extension package for IDE selection context integration.",
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "ide",
    "vscode"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/balaenis/pi-x-ide"
  },
  "bugs": {
    "url": "https://github.com/balaenis/pi-x-ide/issues"
  },
  "homepage": "https://github.com/balaenis/pi-x-ide#readme",
  "packageManager": "pnpm@11.5.2",
  "type": "commonjs",
  "main": "./dist/src/pi/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm --filter pi-x-ide-vscode compile",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter pi-x-ide-vscode typecheck",
    "test": "pnpm build && node --test dist/test/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "compile:vscode": "pnpm --filter pi-x-ide-vscode compile",
    "sync:vscode-assets": "pnpm --filter pi-x-ide-vscode sync:assets",
    "package:vscode": "pnpm --filter pi-x-ide-vscode package",
    "vsix": "pnpm package:vscode"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.27.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.60.1"
  },
  "pi": {
    "extensions": [
      "./src/pi/index.ts"
    ]
  }
}
