{
  "name": "pi-x-ide",
  "version": "1.18.0",
  "description": "Pi extension package for IDE selection context integration.",
  "files": [
    "dist/src",
    "schemas",
    "docs/tutorials",
    "docs/how-to",
    "docs/reference",
    "docs/explanation",
    "docs/zh-CN",
    "docs/specs/ide-protocol.md",
    "config.example.json",
    "CONTRIBUTING.md",
    "CONTRIBUTING.zh-CN.md",
    "CHANGELOG.md",
    "RELEASE.md"
  ],
  "scripts": {
    "prepack": "rm -rf dist && bunx tsc -p tsconfig.publish.json && bun run scripts/build-pi-entry.mjs"
  },
  "keywords": [
    "pi-package",
    "pi",
    "ide",
    "vscode",
    "zed",
    "neovim",
    "nvim",
    "jetbrains",
    "intellij",
    "idea"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/balaenis/pi-x-ide.git"
  },
  "bugs": {
    "url": "https://github.com/balaenis/pi-x-ide/issues"
  },
  "homepage": "https://github.com/balaenis/pi-x-ide#readme",
  "workspaces": [
    "ide-plugins/vscode"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=26"
  },
  "type": "module",
  "main": "./dist/src/pi/index.js",
  "dependencies": {
    "effect": "^3.22.0",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.1",
    "@earendil-works/pi-tui": "^0.80.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "pi": {
    "image": "https://fastly.jsdelivr.net/gh/balaenis/pi-x-ide@main/assets/icons/pi-x-ide.png",
    "extensions": [
      "./dist/src/pi/index.js"
    ]
  }
}
