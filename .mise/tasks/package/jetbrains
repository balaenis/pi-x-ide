#!/usr/bin/env bash
#MISE description="Build the production JetBrains plugin ZIP"
#MISE depends=["setup"]
#
# Arguments after `--` are forwarded to Gradle's `buildPlugin` task.
# Common examples:
#   mise run package:jetbrains -- -PlocalIdePath=$HOME/.cache/pi-x-ide/idea-2026.1.3
#   mise run package:jetbrains -- --dry-run
#   mise run package:jetbrains -- --info --stacktrace
# Supported argument classes:
#   - Gradle project properties: -P<name>=<value> (for example -PlocalIdePath=...)
#   - Gradle execution flags: --dry-run, --info, --debug, --stacktrace, --scan
set -euo pipefail

cd ide-plugins/jetbrains && ./gradlew buildPlugin "$@"
