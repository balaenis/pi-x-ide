#!/usr/bin/env bash
#MISE description="Compile the TypeScript code"
#MISE depends=["setup"]
set -euo pipefail

# Wipe dist so stale artifacts (e.g. a leftover package.json with the wrong
# "type") cannot change how Node loads the compiled ESM test/output files.
rm -rf dist
bunx tsgo -p tsconfig.json
bun run scripts/build-pi-entry.mjs
