{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Pi x IDE VS Code Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/vscode", "${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/vscode/out/extension.js"],
      "preLaunchTask": "bun: build"
    }
  ]
}
