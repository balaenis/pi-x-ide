{
  "name": "pi-x-ide",
  "displayName": "Pi x IDE for VS Code",
  "description": "Send the active VS Code file and selection to Pi.",
  "icon": "assets/icons/icon-mark-128.png",
  "version": "1.8.0",
  "publisher": "balaenis",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/balaenis/pi-x-ide",
    "directory": "vscode"
  },
  "bugs": {
    "url": "https://github.com/balaenis/pi-x-ide/issues"
  },
  "homepage": "https://github.com/balaenis/pi-x-ide#readme",
  "type": "commonjs",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pi-x-ide.attachSelection",
        "title": "Pi x IDE: Attach Selection to Pi"
      },
      {
        "command": "pi-x-ide.openPiTerminal",
        "title": "Open Pi in Terminal",
        "icon": {
          "light": "assets/icons/icon-light.png",
          "dark": "assets/icons/icon-dark.png"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pi-x-ide.openPiTerminal",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pi-x-ide.attachSelection",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Pi x IDE",
      "properties": {
        "piXIde.rangeFormat": {
          "type": "string",
          "enum": [
            "comma",
            "dash"
          ],
          "default": "comma",
          "description": "Line range format used for manual @file references."
        },
        "piXIde.useTmux": {
          "type": "boolean",
          "default": false,
          "description": "Open `Pi Tui` with `tmux` when opening the terminal."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync:assets": "bun run scripts/sync-shared-assets.mjs",
    "compile": "bun -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\" && bun run typecheck && bun run esbuild.mjs",
    "compile:prod": "bun -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\" && bun run typecheck && bun run esbuild.mjs --production",
    "package": "bun run sync:assets && bun run compile:prod && mkdir -p dist && vsce package --no-dependencies --out ./dist/${npm_package_name}-${npm_package_version}.vsix"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/vscode": "^1.120.0",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3"
  }
}
